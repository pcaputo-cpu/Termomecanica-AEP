# SAP Connection
SAP_HOST=your_sap_host
SAP_PORT=8000
SAP_CLIENT=100
SAP_LANG=EN
SAP_USER=your_username
SAP_PASSWORD=your_password

# SAP RFC/OData Settings
SAP_GATEWAY_HOST=your_gateway_host
SAP_GATEWAY_PORT=8080
SAP_ODATA_SERVICE_URL=https://your_sap_gateway/sap/opu/odata/sap/

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=termomecanica_aep
DB_USER=postgres
DB_PASSWORD=postgres

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Frontend
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=24h

# Logging
LOG_LEVEL=debug